---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import logo from '../assets/logo.svg?raw';
import github from '../assets/icons/github.svg?raw';
import mail from '../assets/icons/mail.svg?raw';
import linkedin from '../assets/icons/linkedin.svg?raw';
import pin from '../assets/icons/pin.svg?raw';
import phone from '../assets/icons/phone.svg?raw';
import profile from '../assets/profile.png';
import { withBase } from '../lib/url';

const email = 'desansilva0@gmail.com';
const githubUrl = 'https://github.com/desansilva';
const linkedinUrl = 'https://www.linkedin.com/in/desansilva/';
const contacts = [
	{ icon: mail, text: email, href: `mailto:${email}`, cls: 'r-mail' },
	{ icon: github, text: githubUrl, href: githubUrl, cls: 'r-github' },
	{ icon: linkedin, text: linkedinUrl, href: linkedinUrl, cls: 'r-linkedin' },
	{ icon: pin, text: 'Colombo, Sri Lanka', cls: 'r-pin' },
	{ icon: phone, text: '+94 70 283 5523', cls: 'r-phone' },
];
---
<BaseLayout title="Desan Silva | AI/ML Engineer & Researcher" description="Portfolio of Desan Silva, AI/ML Engineer & Researcher.">
	<Hero />
	<header class="top">
		<a class="logo" href="#top" aria-label="Home"><Fragment set:html={logo} /></a>
		<a class="soc s-in" href={linkedinUrl} aria-label="LinkedIn"><Fragment set:html={linkedin} /></a>
		<a class="soc s-gh" href={githubUrl} aria-label="GitHub"><Fragment set:html={github} /></a>
		<a class="soc s-ml" href={`mailto:${email}`} aria-label="Email"><Fragment set:html={mail} /></a>
		<nav aria-label="Primary">
			<a href="#projects">Projects</a>
			<a href="#research">Research</a>
			<a href="#contact">Contact</a>
		</nav>
	</header>
	<main id="top">
		<section data-screen="1" class="s1">
			<p class="kicker">Portfolio</p>
			<h1>Desan Silva</h1>
			<hr />
			<p class="tag">AI/ML Engineer &amp; Researcher</p>
			<div class="cta">
				<a class="btn line" href={withBase('/docs/resume.pdf')}>View Resume</a>
				<a class="btn fill" href="#contact">Get In Touch{' '}<svg width="28" height="10" viewBox="0 0 28 10" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M0 5h27M23 1l4 4-4 4"/></svg></a>
			</div>
		</section>
		<section data-screen="2" class="s2">
			<div class="about">
				<p>I’m An AI Engineer And Data Science Specialist With Industry Internship Experience And Academic Foundations In Computer Science.</p>
				<p>Focused On Physics-Informed Machine Learning (PIML) And Scalable Data Engineering, Bridging Mathematical Modeling With Production-Ready Systems To Solve Complex Computational And Physical-World Problems.</p>
			</div>
			<Image class="portrait" src={profile} alt="Portrait of Desan Silva" width={480} loading="lazy" format="webp" />
			<p class="edu">Undergraduate - BSc. Computer Science ( UCSC, Sri Lanka)<br />Undergraduate - BSc. Data Science (Coventry University, UK)</p>
		</section>
		<section data-screen="3" class="s3" id="contact">
			<h2>Get In Touch</h2>
			<p class="sub">Open To Collaborate On Tech &amp; Research Projects</p>
			<ul class="rows">
				{contacts.map((c) => (
					<li class={c.cls}>
						<Fragment set:html={c.icon} />
						{c.href ? <a href={c.href}>{c.text}</a> : <span>{c.text}</span>}
					</li>
				))}
			</ul>
			<form action={`mailto:${email}`} method="post" enctype="text/plain">
				<label for="name">Your Name</label>
				<input id="name" name="name" autocomplete="name" required />
				<label for="email">Your E-Mail</label>
				<input id="email" name="email" type="email" autocomplete="email" required />
				<label for="message">Message</label>
				<textarea id="message" name="message" required></textarea>
				<button type="submit" aria-label="Send message"><svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M26 2L2 13l9 3 3 9zM26 2L11 16"/></svg></button>
			</form>
		</section>
	</main>
	<footer><p>All Rights Reserved{' '}&nbsp;© Desan Silva 2026</p></footer>
</BaseLayout>
