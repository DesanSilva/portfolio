---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
const resume = withBase('/docs/resume.pdf');
const bars = [2,8,13,20,26,29,36,39,43,53,60,62,66,74,79,83,92,98,102,105,110,113,119,125,128,132,135];
const widths = [3,2,5,2,2,5,1,2,5,2,1,2,6,3,3,6,2,3,1,3,2,1,5,1,2,1,2];
---
<BaseLayout title="Desan Silva" description="AI/ML Engineer & Researcher">
	<header class="site-header">
		<a class="pin" style="left:390px;top:56px" href="#top" aria-label="Home">
			<svg width="141" height="24" viewBox="0 0 141 24" aria-hidden="true">
				{bars.map((x, i) => <rect x={x} y="0" width={widths[i]} height="24" fill="#eaeaea" />)}
			</svg>
		</a>
		<a class="pin" style="left:566px;top:56px" href="https://www.linkedin.com/in/desansilva/" aria-label="LinkedIn">
			<svg width="23" height="22" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" fill="none" stroke="#eaeaea" stroke-width="1.5"/><path d="M7 10v7M7 7h.01M11 17v-4a2 2 0 1 1 4 0v4" fill="none" stroke="#eaeaea" stroke-width="1.5"/></svg>
		</a>
		<a class="pin" style="left:611px;top:56px" href="https://github.com/desansilva" aria-label="GitHub">
			<svg width="24" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="#eaeaea" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.56 9.56 0 0 1 12 6.8c.85 0 1.7.11 2.5.34 1.9-1.29 2.74-1.02 2.74-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86v2.76c0 .26.18.58.69.48A10 10 0 0 0 12 2z"/></svg>
		</a>
		<a class="pin" style="left:657px;top:56px" href="mailto:desansilva0@gmail.com" aria-label="Email">
			<svg width="28" height="22" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="#eaeaea" stroke-width="1.5"/><path d="M4 7l8 6 8-6" fill="none" stroke="#eaeaea" stroke-width="1.5"/></svg>
		</a>
		<nav aria-label="Section">
			<a class="pin" style="left:1137px;top:60px" href="#projects">Projects</a>
			<a class="pin" style="left:1282px;top:60px" href="#research">Research</a>
			<a class="pin" style="left:1439px;top:59px" href="#contact">Contact</a>
		</nav>
	</header>
	<main id="top">
		<section data-screen="1" class="stack">
			<p class="pin" style="left:197px;top:278px;width:747px;font-size:28px;line-height:39px;color:#e7e7e7">I'm An AI Engineer And Data Science Specialist With Industry Internship Experience And Academic Foundations In Computer Science.</p>
			<p class="pin" style="left:195px;top:472px;width:761px;font-size:22px;line-height:38px;color:#777777">Focused On Physics-Informed Machine Learning (PIML) And Scalable Data Engineering, Bridging Mathematical Modeling With Production-Ready Systems To Solve Complex Computational And Physical-World Problems.</p>
			<p class="pin" style="left:197px;top:859px;font-size:13px;line-height:15px;color:#555555">Undergraduate - BSc. Computer Science ( UCSC, Sri Lanka)</p>
			<p class="pin" style="left:197px;top:884px;font-size:13px;line-height:14px;color:#555555">Undergraduate - BSc. Data Science (Coventry University, UK)</p>
		</section>
		<section data-screen="2" id="contact" class="stack">
			<h2 class="pin" style="left:580px;top:182px;width:478px;font-size:56px;line-height:63px;font-weight:500;color:#eaeaea">Get In Touch</h2>
			<p class="pin" style="left:559px;top:260px;width:544px;font-size:16px;line-height:23px;color:#a8a8a8">Open To Collaborate On Tech & Research Projects</p>
			<svg class="pin" style="left:260px;top:444px" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="#eaeaea"/><path d="M4 7l8 6 8-6" fill="none" stroke="#eaeaea"/></svg>
			<a class="pin" style="left:299px;top:441px;font-size:20px" href="mailto:desansilva0@gmail.com">desansilva0@gmail.com</a>
			<svg class="pin" style="left:260px;top:524px" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="#eaeaea"/><circle cx="12" cy="12" r="3" fill="none" stroke="#eaeaea"/></svg>
			<a class="pin" style="left:299px;top:521px;font-size:20px" href="https://github.com/desansilva">https://github.com/desansilva</a>
			<svg class="pin" style="left:260px;top:595px" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" fill="none" stroke="#eaeaea"/></svg>
			<a class="pin" style="left:299px;top:592px;font-size:20px" href="https://www.linkedin.com/in/desansilva/">https://www.linkedin.com/in/desansilva/</a>
			<svg class="pin" style="left:260px;top:682px" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11z" fill="none" stroke="#eaeaea"/></svg>
			<p class="pin" style="left:295px;top:680px;font-size:20px">Colombo, Sri Lanka</p>
			<svg class="pin" style="left:260px;top:760px" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3h3l2 5-2 1a12 12 0 0 0 6 6l1-2 5 2v3c0 1-1 2-2 2C10 20 4 14 4 5c0-1 1-2 2-2z" fill="none" stroke="#eaeaea"/></svg>
			<p class="pin" style="left:304px;top:758px;font-size:20px">+94 70 283 5523</p>
			<label class="pin" style="left:1072px;top:392px;font-size:13px" for="name">Your Name</label>
			<input class="pin field" style="left:1049px;top:411px;width:566px;height:80px" id="name" name="name" />
			<label class="pin" style="left:1072px;top:495px;font-size:13px" for="email">Your E-Mail</label>
			<input class="pin field" style="left:1021px;top:514px;width:620px;height:80px" id="email" name="email" type="email" />
			<label class="pin" style="left:1072px;top:593px;font-size:13px" for="message">Message</label>
			<textarea class="pin field msg" style="left:1040px;top:622px;width:575px;height:220px" id="message" name="message"></textarea>
			<svg class="pin" style="left:1552px;top:800px" width="32" height="32" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11l18-8-8 18-2-7z" fill="none" stroke="#eaeaea" stroke-width="1.4"/></svg>
		</section>
		<section data-screen="3" class="stack">
			<div class="hero-bg" aria-hidden="true"></div>
			<p class="pin" style="left:104px;top:652px;font-size:22px;line-height:28px">Portfolio</p>
			<h1 class="pin" style="left:104px;top:680px;width:975px;font-size:132px;line-height:140px;font-weight:300">Desan Silva</h1>
			<div class="pin rule" style="left:99px;top:860px;width:1211px"></div>
			<p class="pin" style="left:99px;top:891px;font-size:28px;line-height:40px">AI/ML Engineer & Researcher</p>
			<a class="pin btn line" style="left:1239px;top:926px;width:232px" href={resume}>View Resume</a>
			<a class="pin btn fill" style="left:1460px;top:926px;width:244px" href="#contact">Get In Touch <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="#050505" stroke-width="1.4"/></svg><span class="arrow-char">→</span></a>
		</section>
		<footer class="site-foot">
			<p class="foot-line">All Rights Reserved © Desan Silva 2026</p>
		</footer>
	</main>
</BaseLayout>
